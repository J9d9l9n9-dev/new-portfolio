# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
# For local SQLite dev without Docker:
# DATABASE_URL=sqlite:///./portfolio.db

# Security & Authentication
SECRET_KEY=generate-a-secure-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Owner Credentials (Created automatically on startup)
ADMIN_EMAIL=jampadurgalakshminarayana@gmail.com
ADMIN_PASSWORD=AdminPass123!
ADMIN_PATH=/admin

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:5173

# Storage Adapter (local, cloudinary, s3)
STORAGE_TYPE=local
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
