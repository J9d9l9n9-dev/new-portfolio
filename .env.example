# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=portfolio
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/portfolio
# For local SQLite development without Docker:
# DATABASE_URL=sqlite:///./portfolio.db

# Security & Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY=generate-a-secure-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Owner Credentials (Initial admin created automatically at startup)
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password-in-production!
ADMIN_PATH=/admin

# CORS & Networking
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Storage Adapter (local, cloudinary, s3)
STORAGE_TYPE=local
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
